import { Settings } from "pages/MainViews/Settings_ui.slint";
import { PrivateChat } from "pages/MainViews/PrivateChat_ui.slint";
import { ServerChat } from "pages/MainViews/ServerChat_ui.slint";
import { MainSidebar } from "pages/MainSidebar_ui.slint";
import { Home } from "pages/MainViews/Home_ui.slint";
import { Pages } from "globals/Pages.slint";
import { MainView } from "pages/MainView_ui.slint";

export component MainWindow inherits Window
{
	title: "Herald";
	width:  1000px;
	height: 700px;

	in-out property <Pages> current-page: Pages.Home;

	HorizontalLayout
	{
		spacing: 0px;

		MainSidebar
		{
			height: root.height;
			width: 10%;


			current-page <=> root.current-page;
		}

			MainView
			{
				height: root.height;
				width: 90%;
	
				current-page: root.current-page;
			}
	}

}

export * from "globals/Globals.slint";
