import { ScrollableChat } from "pages/ScrollableChat_ui.slint";
import { ChatState } from "globals/ChatState.slint";
import { ChatActions } from "globals/ChatActions.slint";

export component MainWindow inherits Window
{
	title: "Herald";
	width:  400px;
	height: 400px;

	ScrollableChat
	{
		width: root.width;
		height: root.height;
		
		send-message(author, message) =>
		{
			ChatActions.send(author, message);
		}
	}
}

export * from "globals/Globals.slint";
