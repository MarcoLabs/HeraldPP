import { ScrollableChat } from "pages/ScrollableChat_ui.slint";
import { ChatState, Message } from "globals/ChatState_ui.slint";
import { ChatActions } from "globals/ChatActions_ui.slint";

export component MainWindow inherits Window
{
	title: "Herald";
	width:  400px;
	height: 400px;

	ScrollableChat
	{
		width: root.width;
		height: root.height;

		messages: ChatState.messages;
	}
}

export { ChatState, Message }
export { ChatActions }
