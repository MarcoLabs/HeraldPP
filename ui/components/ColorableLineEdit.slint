import { AppTheme } from "../globals/Style.slint";

export component ColorableLineEdit
{
	callback accepted;
	
	in-out property <string> text <=> input.text;
	in property <string> placeholder-text;
	in property <color> background: AppTheme.current-theme.surface;
	in property <color> border-color: AppTheme.current-theme.border;
	in property <color> text-color: AppTheme.current-theme.text-primary;
	in property <color> placeholder-color: AppTheme.current-theme.text-muted;

	Rectangle
	{
		background: root.background;
		border-radius: 4px;
		border-width: 1px;
		border-color: root.border-color;

		if input.text == "": Text
		{
			x: 8px;
			text: root.placeholder-text;
			color: root.placeholder-color;
			vertical-alignment: center;
		}

		input := TextInput
		{
			x: 8px;
			width: parent.width - 16px;
			color: root.text-color;
			vertical-alignment: center;

			accepted =>
			{
				root.accepted();
			}
		}
	}
}
