import { Pages } from "globals/Pages.slint";

import { PrivateChat } from "pages/PrivateChat_ui.slint";
import { ServerChat } from "pages/ServerChat_ui.slint";
import { MainSidebar } from "MainSidebar_ui.slint";
import { Settings } from "pages/Settings_ui.slint";
import { Home } from "pages/Home_ui.slint";

export component MainView
{
	in property <Pages> current-page;

	if current-page == Pages.Home: Home
	{
		width: 100%;
		height: 100%;
	}
	if current-page == Pages.ServerChat: ServerChat
	{
		width: 100%;
		height: 100%;
	}
	if current-page == Pages.PrivateChat: PrivateChat
	{
		width: 100%;
		height: 100%;
	}
	if current-page == Pages.Settings: Settings
	{
		width: 100%;
		height: 100%;
	}
}
