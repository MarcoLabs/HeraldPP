import { Message } from "MessageType.slint";

export struct Channel
{
	name: string,
	selected: bool,
}

export global ServerState
{
	in-out property <string> server-name;
	in-out property <[Channel]> channels: [
		{ name: "General", selected: true },
		{ name: "Announcements", selected: false },
		{ name: "Development", selected: false },
		{ name: "Support", selected: false },
		{ name: "Random", selected: false }
	];
	in-out property <int> current-channel-index;
	in-out property <[Message]> messages;
}
