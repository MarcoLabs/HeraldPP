import { ChannelsPanel } from "ServerChat/ChannelsPanel_ui.slint";
import { ServerState, ServerActions } from "../globals/Globals.slint";
import { ScrollableChat } from "components/ScrollableChat_ui.slint";
export component ServerChat
{
	HorizontalLayout
	{
		ChannelsPanel
		{
			width: 20%;
		
			channels: ServerState.channels;
			current-channel-index: ServerState.current-channel-index;
			server-name: ServerState.server-name;
		}

		ScrollableChat
		{
			messages: ServerState.messages;

			send-message(author, message-content) =>
			{
				ServerActions.send-message(author, message-content);
			}
		}
	}
}
