import { Message } from "../globals/ChatState.slint";
import { Button } from "std-widgets.slint";
import { ChatActions } from "../globals/ChatActions.slint";

export component ScrollableChat
{
	in property <[Message]> messages;

	private property <int> count;

	for message[i] in messages : Text
	{
		y: i * 25px;
		
		width: parent.width;
		height: 20px;

		text: message.author + ": " + message.content;
	}

	Button
	{
		width: 30px;
		height: 30px;
		text: "Send";
		
		clicked =>
		{
			ChatActions.send(count);
			count += 1;
		}
	}
}
