import { AppTheme } from "../../globals/Style.slint";
import { PanelItem } from "components/PanelItem_ui.slint";
import { Channel } from "../../globals/shared/ServerState.slint";
import { FullSizeChannels } from "components/FullSizeChannels_ui.slint";
import { Utils } from "../../globals/Globals.slint";
import { MinimizedChannels } from "components/MinimizedChannels_ui.slint";

component FullSizeChannelsPanel inherits Rectangle
{
	callback channel-changed(int);
	
	in property <string> server-name;
	in-out property <[Channel]> channels;
	in-out property <int> current-channel-index;

	VerticalLayout
	{
		alignment: start;

		PanelItem
		{
			height: 10%;

			Text
			{
				text: server-name;
				color: AppTheme.current-theme.text-primary;
				font-weight: 700;
			}
		}

		PanelItem
		{
			height: 90%;

			FullSizeChannels
			{
				channels: channels;

				channel-changed(index) =>
				{
					channels[current-channel-index].selected = false;
					channels[index].selected = true;

					current-channel-index = index;

					root.channel-changed(index);
				}
			}
		}
	}
}

component MinimizedChannelsPanel inherits Rectangle
{
	callback channel-changed(int);
	
	in property <string> server-name;
	in-out property <[Channel]> channels;
	in-out property <int> current-channel-index;

	VerticalLayout
	{
		alignment: start;

		PanelItem
		{
			height: 10%;

			Text
			{
				x: 8px;
				width: parent.width - 16px;
				horizontal-alignment: left;
				text: Utils.uppercase(Utils.first-two(server-name));
				color: AppTheme.current-theme.text-primary;
				font-weight: 700;
			}
		}

		PanelItem
		{
			height: 90%;

			MinimizedChannels
			{
				channels: channels;

				channel-changed(index) =>
				{
					channels[current-channel-index].selected = false;
					channels[index].selected = true;

					current-channel-index = index;

					root.channel-changed(index);
				}
			}
		}
	}
}

export component ChannelsPanel inherits Rectangle
{
	callback channel-changed(int);

	in-out property <[Channel]> channels;
	in-out property <int> current-channel-index;
	in property <string> server-name;
	in property <bool> is-minimized;

	border-width: 1px;
	border-color: AppTheme.current-theme.border;
	background: AppTheme.current-theme.panel;

	if (is-minimized) : MinimizedChannelsPanel
	{
		server-name: root.server-name;
		channels <=> root.channels;
		current-channel-index <=> root.current-channel-index;

		channel-changed(index) =>
		{
			root.channel-changed(index);
		}
	}

	if (! is-minimized) : FullSizeChannelsPanel
	{
		server-name: root.server-name;
		channels <=> root.channels;
		current-channel-index <=> root.current-channel-index;

		channel-changed(index) =>
		{
			root.channel-changed(index);
		}
	}
}
