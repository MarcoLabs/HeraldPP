import { AppTheme } from "../../globals/Style.slint";
import { PanelItem } from "components/PanelItem_ui.slint";
import { Channel } from "../../globals/shared/ServerState.slint";

export component ChannelsPanel inherits Rectangle
{
	in property <string> server-name;
	in property <[Channel]> channels;

	border-width: 1px;
	border-color: AppTheme.current-theme.border;

	VerticalLayout
	{
		PanelItem
		{
			Text
			{
				text: server-name;
			}
		}

		PanelItem
		{
			Text
			{
				text: "Channels";
				color: AppTheme.current-theme.text-muted;
			}
			
			for channel in channels : Text
			{
				text: "# " + channel.name;
				color: channel.selected ? AppTheme.current-theme.text-primary : AppTheme.current-theme.text-muted;
			}
		}
	}
}
