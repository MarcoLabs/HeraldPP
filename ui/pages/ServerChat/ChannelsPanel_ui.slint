import { AppTheme } from "../../globals/Style.slint";
import { PanelItem } from "components/PanelItem_ui.slint";
import { Channel } from "../../globals/shared/ServerState.slint";
import { Channels } from "components/Channels_ui.slint";

export component ChannelsPanel inherits Rectangle
{
	in-out property <[Channel]> channels;
	in-out property <int> current-channel-index;
	in property <string> server-name;

	border-width: 1px;
	border-color: AppTheme.current-theme.border;
	background: AppTheme.current-theme.panel;

	VerticalLayout
	{
		alignment: start;
	
		PanelItem
		{
			height: 10%;

			Text
			{
				text: server-name;
			}
		}

		PanelItem
		{
			height: 90%;

			Channels
			{
				channels: channels;

				channel-changed(index) =>
				{
					channels[current-channel-index].selected = false;
					channels[index].selected = true;

					current-channel-index = index;
				}
			}
		}
	}
}
