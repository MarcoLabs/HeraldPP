import { Channel } from "../../../globals/shared/ServerState/ServerState.slint";
import { AppTheme } from "../../../globals/Style.slint";
import { Utils } from "../../../globals/shared/Utils.slint";

component ChannelItem inherits Rectangle
{
	callback clicked;

	in property <Channel> channel;
	in property <bool> is-minimized;

	background: channel.selected ? AppTheme.current-theme.accent : touch.has-hover ? AppTheme.current-theme.border.with-alpha(0.5) : transparent;
	border-radius: 8px;
	height: 32px;

	animate background { duration: 120ms; easing: ease-out; }

	if is-minimized : HorizontalLayout
	{
		padding-left: 10px;
		padding-right: 4px;
	
		Text
		{
			text: Utils.first-two(channel.name);
			horizontal-alignment: left;
			vertical-alignment: center;
			overflow: clip;
			font-size: 13px;
			font-weight: channel.selected ? 700 : 500;
			color: channel.selected || touch.has-hover ? AppTheme.current-theme.text-primary : AppTheme.current-theme.text-muted;
	
			animate color { duration: 120ms; easing: ease-out; }
		}
	}

	if !is-minimized : HorizontalLayout
	{
		padding-left: 10px;
		padding-right: 10px;
		spacing: 8px;

		Text
		{
			text: "#";
			vertical-alignment: center;
			font-size: 15px;
			font-weight: 700;
			color: channel.selected ? AppTheme.current-theme.text-primary : AppTheme.current-theme.text-muted.with-alpha(0.7);

			animate color { duration: 120ms; easing: ease-out; }
		}

		Text
		{
			text: channel.name;
			vertical-alignment: center;
			overflow: elide;
			font-size: 14px;
			font-weight: channel.selected ? 650 : 500;
			color: channel.selected || touch.has-hover ? AppTheme.current-theme.text-primary : AppTheme.current-theme.text-muted;

			animate color { duration: 120ms; easing: ease-out; }
		}
	}

	touch := TouchArea
	{
		mouse-cursor: pointer;

		clicked =>
		{
			root.clicked();
		}
	}
}

export component Channels inherits Rectangle
{
	callback channel-changed(int);

	in property <[Channel]> channels;
	in property <bool> is-minimized;

	VerticalLayout
	{
		padding: 8px;
		spacing: 2px;
		alignment: start;

		Rectangle
		{
			height: 28px;

			if is-minimized : Rectangle
			{
				y: parent.height / 2;
				height: 1px;
				background: AppTheme.current-theme.border;
			}

			if !is-minimized : Text
			{
				x: 8px;
				text: "CHANNELS";
				vertical-alignment: center;
				font-size: 11px;
				font-weight: 700;
				letter-spacing: 1px;
				color: AppTheme.current-theme.text-muted;
			}
		}

		for channel[i] in channels : ChannelItem
		{
			channel: channel;
			is-minimized: root.is-minimized;

			clicked =>
			{
				root.channel-changed(i);
			}
		}
	}
}
