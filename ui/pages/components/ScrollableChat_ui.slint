import { ScrollView } from "std-widgets.slint";
import { UserState, Message } from "../../globals/Globals.slint";
import { AppTheme } from "../../globals/Style.slint";
import { ColorableButton } from "../../components/ColorableButton.slint";

component GrowingTextInput inherits Rectangle
{
	callback accepted();

	in property <string> placeholder-text;
	in property <length> max-input-height: 120px;
	in-out property <string> text <=> field.text;

	private property <bool> stick-to-bottom: true;
	private property <length> wanted-height: max(32px, min(root.max-input-height, field.preferred-height + 12px));

	min-height: root.wanted-height;
	preferred-height: root.wanted-height;
	max-height: root.wanted-height;
	border-width: 1px;
	border-radius: 4px;
	border-color: AppTheme.current-theme.text-primary.with-alpha(0.4);
	background: AppTheme.current-theme.bg-primary;
	clip: true;

	function pin-to-bottom()
	{
		if (field.text.is-empty)
		{
			root.stick-to-bottom = true;
		}

		if (root.stick-to-bottom)
		{
			scroller.content-y = min(0px, scroller.visible-height - scroller.content-height);
		}
	}

	FocusScope
	{
		capture-key-pressed(event) =>
		{
			if (event.text == Key.Return && ! event.modifiers.shift)
			{
				root.accepted();

				return accept;
			}

			return reject;
		}

		scroller := ScrollView
		{
			x: 6px;
			y: 6px;
			width: parent.width - 12px;
			height: parent.height - 12px;
			content-width: self.visible-width;
			content-height: field.height;
			horizontal-scrollbar-policy: always-off;
		
			scrolled =>
			{
				root.stick-to-bottom = self.content-y <= self.visible-height - self.content-height + 10px;
			}
		
			changed content-height =>
			{
				root.pin-to-bottom();
			}
		
			changed visible-height =>
			{
				root.pin-to-bottom();
			}
		
			field := TextInput
			{
				width: scroller.visible-width - 12px;
				height: max(self.preferred-height, scroller.visible-height);
				wrap: word-wrap;
				single-line: false;
				color: AppTheme.current-theme.text-primary;
		
				edited =>
				{
					root.stick-to-bottom = true;
					root.pin-to-bottom();
				}
			}
		
			Text
			{
				x: 6px;
				y: 0px;
				visible: field.text.is-empty;
				text: root.placeholder-text;
				color: AppTheme.current-theme.text-primary.with-alpha(0.5);
			}
		}
	}
}

component ChatInput inherits Rectangle
{
	callback send-message(string, string);

	private property <string> user-input-message;

	function submit()
	{
		if (user-input-message.is-empty)
		{
			return;
		}

		root.send-message(UserState.username, user-input-message);

		user-input-message = "";
	}

	HorizontalLayout
	{
		padding: 10px;

		GrowingTextInput
		{
			width: 85%;

			placeholder-text: "Enter message here";
			text <=> user-input-message;

			accepted =>
			{
				root.submit();
			}
		}

		VerticalLayout
		{
			width: 15%;
			alignment: end;

			ColorableButton
			{
				height: 32px;

				text: "➤";

				clicked =>
				{
					root.submit();
				}
			}
		}
	}
}

export component ScrollableChat inherits Rectangle
{
	callback send-message(string, string);

	in-out property <[Message]> messages;

	private property <bool> stick-to-bottom: true;

	background: AppTheme.current-theme.bg-primary;

	function pin-to-bottom()
	{
		if (root.stick-to-bottom)
		{
			chat-scroll.content-y = min(0px, chat-scroll.visible-height - chat-scroll.content-height);
		}
	}

	VerticalLayout
	{
		padding: 15px;

		chat-scroll := ScrollView
		{
			vertical-stretch: 1;
			content-width: self.visible-width;

			scrolled =>
			{
				root.stick-to-bottom = self.content-y <= self.visible-height - self.content-height + 10px;
			}

			changed content-height =>
			{
				root.pin-to-bottom();
			}

			changed visible-height =>
			{
				root.pin-to-bottom();
			}

			VerticalLayout
			{
				alignment: start;
				spacing: 4px;
				padding-right: 12px;

				for message in root.messages : Text
				{
					wrap: word-wrap;
					text: message.author + ":" + message.content;
					color: AppTheme.current-theme.text-primary;
				}
			}
		}

		ChatInput
		{
			send-message(author, message-content) =>
			{
				root.stick-to-bottom = true;
				root.send-message(author, message-content);
			}
		}
	}
}
