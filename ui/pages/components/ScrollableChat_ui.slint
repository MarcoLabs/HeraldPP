import { Button, ScrollView, LineEdit } from "std-widgets.slint";
import { UserState, Message } from "../../globals/Globals.slint";
import { AppTheme } from "../../globals/Style.slint";
import { ColorableLineEdit } from "../../components/ColorableLineEdit.slint";
import { ColorableButton } from "../../components/ColorableButton.slint";

component ChatInput inherits Rectangle
{
	callback send-message(string, string);

	private property <string> user-input-message;

	HorizontalLayout
	{
		padding: 10px;

		ColorableLineEdit
		{
			width: 85%;
			
			placeholder-text: "Enter message here";
			text <=> user-input-message;

			accepted =>
			{
				if (user-input-message.is-empty)
				{
					return;
				}
	
				root.send-message(UserState.username, user-input-message);
	
				user-input-message = "";
			}
		}

		ColorableButton
		{
			width: 15%;
			
			text: "➤";

			clicked =>
			{
				if (user-input-message.is-empty)
				{
					return;
				}

				root.send-message(UserState.username, user-input-message);

				user-input-message = "";
			}
		}
	}
}

export component ScrollableChat inherits Rectangle
{
	callback send-message(string, string);

	in-out property <[Message]> messages;

	private property <bool> stick-to-bottom: true;
	private property <string> user-input-message;

	background: AppTheme.current-theme.bg-primary;

	VerticalLayout
	{
		padding: 15px;

		ScrollView
		{
			height: 90%;
			content-height: messages.length * 25px;

			scrolled =>
			{
				root.stick-to-bottom = self.content-y <= self.visible-height - self.content-height + 10px;
			}

			changed content-height =>
			{
				if (root.stick-to-bottom)
				{
					self.content-y = min(0px, self.visible-height - self.content-height);
				}
			}

			for message[i] in messages : Text
			{
				y: i * 25px;
				width: parent.width;
				height: 20px;
				text: message.author + ":" + message.content;
				color: AppTheme.current-theme.text-primary;
			}
		}

		ChatInput
		{
			height: 10%;
			
			send-message(author, message-content) =>
			{
				root.send-message(author, message-content);
			}
		}
	}

}
